screen:
  backgroundColor: "panelBG"
  flags: "wfNoBorder"
  name: "JobCockpit"
  position: "center,center"
  resolution: "1920,1080"
  size: "1416,700"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        position: "10,65"
        render: "Listbox"
        scrollbarMode: "showOnDemand"
        size: "e-20,570"
        source: "list"
        children:
          - convert:
              type: "TemplatedMultiContent"
              cell:
                itemHeight: 80
                fonts:
                  - "Regular;28"
                fields:
                  - text:
                      rect: [10, 0, 1000, 40]
                      font: "Regular;28"
                      flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                      value: 0
                  - text:
                      rect: [10, 40, 200, 40]
                      font: "Regular;28"
                      flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                      value: 1
                  - progress:
                      rect: [250, 50, 1000, 20]
                      value: -2
                      borderWidth: 1
                  - text:
                      rect: [1266, 40, 100, 40]
                      font: "Regular;28"
                      flags: RT_HALIGN_RIGHT|RT_VALIGN_CENTER
                      value: 3
    - xmlinc:
        file: "screenpart_BottomBar.ymlinc"
    - xmlinc:
        file: "screenpart_ButtonBar.ymlinc"
        position: "0,$screen_height-48"
